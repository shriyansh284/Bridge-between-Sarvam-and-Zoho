# Copy to .env and fill in. Never commit .env or share it in chat.

# ===== Sarvam ==============================================================
SARVAM_API_KEY=                          # Sarvam dashboard -> Settings -> API Key (use a fresh key)
SARVAM_ORG_ID=                           # from the dashboard URL / Settings
SARVAM_WORKSPACE_ID=                     # from the dashboard URL / Settings
SARVAM_APP_ID=Conversatio-3f6c465d-6251  # your calling agent
SARVAM_APP_VERSION=1                     # the committed version to use
SARVAM_CONNECTION_ID=                    # Phone Numbers -> your telephony connection
SARVAM_AGENT_PHONE_NUMBER=               # the number calls come from, e.g. +918045xxxxxx
SARVAM_PHONE_FORMAT=e164                 # e164 (+919876543210) | digits (919876543210) | national

# Sheet field -> agent variable names (default matches your cohort CSV headers)
# AGENT_VARIABLE_MAP={"name":"candidate_name","Name_of_Hiring_company":"hiring_company","pending_document_names":"pending_documents","whatsapp_message_date":"whatsapp_message_date"}
# Result column -> agent output variable (edit to your agent's output names)
# RESULT_FIELD_MAP={"Candidate Response":"disposition","Call Summary":"summary","Next Follow-up Date":"follow_up_date"}

# ===== Client SFTP folder ===================================================
# The client uploads files to DROP_DIR/inbox over SFTP; output sheets appear in DROP_DIR/send and
# missed calls (and files that can't be used) in DROP_DIR/failed.
# On the server, deploy/setup_sftp.sh creates the folder and the client's login and fills in DROP_DIR.
DROP_DIR=                                # e.g. /srv/ams-sftp/amsclient (on a PC, any folder, e.g. D:/ams-drop)
DROP_POLL_SECONDS=30
DROP_SETTLE_SECONDS=60                   # a file must be unchanged this long before it's read (upload finished)
DROP_RESULT_FORMAT=csv                   # csv | xlsx | both
DROP_DATE_ORDER=dmy                      # only when a file's dates read either way (05/11/2026): dmy | mdy (11/25/2026)
DUPLICATE_FILE_DAYS=7                    # the same file, or the same phone + call time, isn't called again within N days

# ===== Call results =========================================================
# No public address is needed: finished calls are fetched from Sarvam every RESULT_POLL_SECONDS,
# and recording links in the result files are Sarvam's own signed links (turn on "Public signed URLs" in
# Sarvam: Settings -> Workspace -> Data policy).
RESULT_POLL_SECONDS=60
# Optional, only if the server has a public HTTPS address: Sarvam also posts results to it
# straight away, and recording links go through this server (30 days).
PUBLIC_BASE_URL=                         # e.g. https://calls.yourcompany.com, or leave empty
WEBHOOK_SECRET=                          # python -c "import secrets;print(secrets.token_urlsafe(32))"
LINK_SECRET=                             # same command; signs recording links in the result files
RECORDING_LINK_DAYS=30

# ===== Calling rules =======================================================
TIMEZONE=Asia/Kolkata
CALL_WINDOW_START=09:00
CALL_WINDOW_END=21:00
CALL_DAYS=0,1,2,3,4,5,6                  # 0=Mon ... 6=Sun
BLANK_TIME=now                           # row without date/time: now | reject
MAX_ATTEMPTS=2                           # calls per candidate before "No Answer"
RETRY_GAP_MINUTES=60
RESULT_TIMEOUT_MINUTES=45                # no result by then -> "under review", never auto-redialed
MAX_CALLS_PER_CYCLE=5                    # calls started per 20-second cycle
SCHEDULER_POLL_SECONDS=20

# ===== Result files ========================================================
BATCH_MODE=slot                          # update the results file after each Call Date+Time group | size | final
BATCH_SIZE=10                            # only for BATCH_MODE=size

# ===== Storage / dashboard ================================================
DATA_DIR=                                # blank = ./data
DASHBOARD_USERS_FILE=config/users.json
