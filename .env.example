# Copy to .env and fill in. Never commit .env or share it in chat.

# ===== Sarvam ==============================================================
SARVAM_API_KEY=                          # Sarvam dashboard -> Settings -> API Key (use a fresh key)
SARVAM_ORG_ID=                           # from the dashboard URL / Settings
SARVAM_WORKSPACE_ID=                     # from the dashboard URL / Settings
SARVAM_APP_ID=Conversatio-3f6c465d-6251  # your calling agent
SARVAM_APP_VERSION=1                     # the committed version to use
SARVAM_CONNECTION_ID=                    # Phone Numbers -> your telephony connection
SARVAM_AGENT_PHONE_NUMBER=               # the number calls come from, e.g. +918045xxxxxx
SARVAM_PHONE_FORMAT=e164                 # e164 (+919876543210) | digits (919876543210) | national

# Sheet field -> agent variable names (default matches your cohort CSV headers)
# AGENT_VARIABLE_MAP={"name":"candidate_name","Name_of_Hiring_company":"hiring_company","pending_document_names":"pending_documents","whatsapp_message_date":"whatsapp_message_date"}
# Excel result column -> agent output variable (edit to your agent's output names)
# RESULT_FIELD_MAP={"Candidate Response":"disposition","Call Summary":"summary","Next Follow-up Date":"follow_up_date"}

# ===== Zoho Mail (Self Client, India data centre) ==========================
ZOHO_DC=in                               # in | com | eu | com.au | jp | ca | sa
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=                       # only for a Server-based client: its Authorized Redirect URI
ZOHO_REFRESH_TOKEN=                      # python -m ams.zoho_setup token <GRANT_CODE>   (Server-based: zoho_setup url first)
ZOHO_FROM_ADDRESS=calling@yourcompany.com   # the fixed address clients email
ZOHO_FOLDER=Inbox                        # or a folder a Zoho filter fills with client mail, e.g. "AMS Pending Document"
ZOHO_ACCOUNT_ID=                         # optional; found automatically
MAIL_ENABLED=true                        # false = never touch the inbox or send (files saved only)
MAIL_POLL_SECONDS=60
ALLOWED_SENDERS=@clientdomain.com        # emails or @domains allowed to start campaigns; blank = anyone
REPLY_CC=                                # optional internal copy of every reply
SEND_ACK=true                            # reply "received" with the schedule as soon as a file arrives
DUPLICATE_FILE_DAYS=7                    # same file from same sender within N days is not called again

# ===== Public URL (HTTPS) ==================================================
PUBLIC_BASE_URL=https://calls.yourcompany.com   # where ams.server is reachable
WEBHOOK_SECRET=                          # python -c "import secrets;print(secrets.token_urlsafe(32))"
LINK_SECRET=                             # same command; signs recording links in the Excel
RECORDING_LINK_DAYS=30

# ===== Calling rules =======================================================
TIMEZONE=Asia/Kolkata
CALL_WINDOW_START=09:00
CALL_WINDOW_END=21:00
CALL_DAYS=0,1,2,3,4,5,6                  # 0=Mon ... 6=Sun
BLANK_TIME=now                           # row without date/time: now | reject
MAX_ATTEMPTS=2                           # calls per candidate before "No Answer"
RETRY_GAP_MINUTES=60
RESULT_TIMEOUT_MINUTES=45                # no result by then -> "under review", never auto-redialed
MAX_CALLS_PER_CYCLE=5                    # calls started per 20-second cycle
SCHEDULER_POLL_SECONDS=20

# ===== Result emails =======================================================
BATCH_MODE=slot                          # slot = after each Call Date+Time group | size | final
BATCH_SIZE=10                            # only for BATCH_MODE=size

# ===== Storage / dashboard ================================================
DATA_DIR=                                # blank = ./data
DASHBOARD_USERS_FILE=config/users.json
